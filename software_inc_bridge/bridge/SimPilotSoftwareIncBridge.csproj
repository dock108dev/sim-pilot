<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SimPilot.SoftwareInc.Bridge</AssemblyName>
    <RootNamespace>SimPilotSoftwareIncBridge</RootNamespace>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <SoftwareIncManagedPath Condition="'$(SoftwareIncManagedPath)' == ''">__SOFTWARE_INC_MANAGED_PATH_REQUIRED__</SoftwareIncManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../rail_route_bridge/src/SimPilot.GameBridge.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SoftwareIncManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SoftwareIncManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SoftwareIncManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SoftwareIncManagedPath)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SoftwareIncManagedPath)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateSoftwareIncRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SoftwareIncManagedPath)/Assembly-CSharp.dll')" Text="Set SoftwareIncManagedPath to the exact Software Inc. managed assembly directory." />
  </Target>
</Project>
